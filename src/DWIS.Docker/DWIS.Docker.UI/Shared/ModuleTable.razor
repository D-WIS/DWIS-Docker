@* The one table of predefined modules, reused by Standard setup, DWIS Modules, Clients and Advisors.
   One row per container; clients and advisors can have several, each bound to its own blackboard. *@
@inherits DwisComponentBase

<MudTable T="ModuleRow" Items="Items" Dense Hover Elevation="1" Class="dwis-module-table" HorizontalScrollbar
          MultiSelection="MultiSelection" SelectOnRowClick="false"
          SelectedItems="_selected" SelectedItemsChanged="OnSelectionChanged"
          GroupBy="@(GroupByCategory ? _groupDefinition : null)" GroupHeaderClass="dwis-group-header"
          RowClassFunc="RowClass">
    <ToolBarContent>
        <BulkToolbar Title="@Title" Selection="_selected" ClearSelection="ClearSelection" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Module</MudTh>
        <MudTh>Container</MudTh>
        <MudTh>State</MudTh>
        <MudTh>Image</MudTh>
        <MudTh>Details</MudTh>
        <MudTh Style="width: 1%">Actions</MudTh>
    </HeaderContent>
    <GroupHeaderTemplate>
        <MudTh colspan="7">
            @(context.Key is ModuleCategory cat ? cat.DisplayName() : context.Key?.ToString())
            <MudText Typo="Typo.caption" Class="ml-2" Inline>
                @context.Items.Count(r => r.IsRunning) / @context.Items.Count(r => r.Exists) running
            </MudText>
        </MudTh>
    </GroupHeaderTemplate>
    <RowTemplate>
        <MudTd DataLabel="Module">
            <MudText Typo="Typo.body2" Class="dwis-nowrap"><b>@context.Module.DisplayName</b></MudText>
            <span class="dwis-caption">@context.Module.ImageRef</span>
        </MudTd>
        <MudTd DataLabel="Container">
            @if (context.Container is { } c)
            {
                <MudText Typo="Typo.body2" Class="dwis-nowrap">@c.Name</MudText>
                <span class="dwis-caption">@c.StatusText</span>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="dwis-nowrap" Style="opacity: .5">@PlaceholderName(context.Module)</MudText>
            }
        </MudTd>
        <MudTd DataLabel="State">
            <StateChip Look="DwisStates.Container(context.Container)" />
            @if (context.Instance?.IsLegacy == true)
            {
                <StateChip Look="@(new StateLook(DwisIcons.Legacy, Color.Default, "Old format", "Created by a previous version. Update the image to migrate it."))" />
            }
        </MudTd>
        <MudTd DataLabel="Image">
            <StateChip Look="DwisStates.Image(context.Status.ImageStatus, context.Status.ImagePresent)" />
        </MudTd>
        <MudTd DataLabel="Details">
            @if (context.Module.IsBlackboard)
            {
                @if (BlackboardOf(context) is { } bb)
                {
                    <ReplicationChip Replicating="bb.IsReplicating" HubUrl="@bb.HubUrl" Group="@bb.Group" />
                    <MudChip T="string" Icon="@DwisIcons.Port" Variant="Variant.Text" Size="Size.Small" Class="dwis-chip">@bb.Port</MudChip>
                    @if (context.Status.ReplicationMismatch && bb == context.Status.Blackboard)
                    {
                        <StateChip Look="@(new StateLook(DwisIcons.Mismatch, Color.Warning, "Differs from settings", "This blackboard was created with another hub or group than the current replication target. Update the image to recreate it."))" />
                    }
                }
                else
                {
                    <ReplicationChip Replicating="AppSettings.ReplicationEnabled && AppSettings.ReplicationHub is not null" HubUrl="@AppSettings.ReplicationHub?.BaseUrl" Group="@AppSettings.ReplicationGroup" />
                    <MudChip T="string" Icon="@DwisIcons.Port" Variant="Variant.Text" Size="Size.Small" Class="dwis-chip">@context.Module.HostPort</MudChip>
                }
            }
            else
            {
                @if (context.Module.HasConfig)
                {
                    <StateChip Look="DwisStates.Config(context.Status.ConfigFileExists)" OnClick="@(() => ToggleConfig(context.Key))" />
                }
                @if (context.Module.IsWebApp)
                {
                    @if (context.Instance is { } inst)
                    {
                        @if (inst.Blackboard is { } target)
                        {
                            <MudTooltip Text="@($"{ModuleCatalog.BlackboardIpEnvVar}={AppSettings.BlackboardHostIp}, {ModuleCatalog.BlackboardPortEnvVar}={target.Port}")">
                                <MudChip T="string" Icon="@DwisIcons.Blackboard" Variant="Variant.Text" Size="Size.Small" Color="@(BlackboardExists(target) ? Color.Primary : Color.Warning)" Class="dwis-chip">@target.ContainerName : @target.Port</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="@($"Created without a blackboard. It uses {ModuleCatalog.BlackboardIpEnvVar} and the default port {ModuleCatalog.DefaultBlackboardPort}.")">
                                <MudChip T="string" Icon="@DwisIcons.Blackboard" Variant="Variant.Text" Size="Size.Small" Class="dwis-chip">default blackboard</MudChip>
                            </MudTooltip>
                        }
                    }
                    else
                    {
                        <MudChip T="string" Icon="@DwisIcons.Blackboard" Variant="Variant.Text" Size="Size.Small" Class="dwis-chip" Style="opacity: .6">choose a blackboard on create</MudChip>
                    }
                }
                @if (HostPortOf(context) is { } port)
                {
                    <MudLink Href="@($"http://localhost:{port}")" Target="_blank" Typo="Typo.body2" Class="dwis-nowrap ml-1">
                        <MudIcon Icon="@DwisIcons.Port" Size="Size.Small" Style="vertical-align: middle" /> localhost:@port
                    </MudLink>
                }
            }
        </MudTd>
        <MudTd DataLabel="Actions">
            <ContainerActions Container="context.Container" BusyKey="@context.BusyKey"
                              OnCreate="@(() => Create(context))"
                              CreateText="@(context.Module.IsWebApp ? "Create against a blackboard" : "Create container")"
                              OnUpdateImage="@(() => UpdateImage(context))"
                              OnAddInstance="@(context.Module.IsWebApp ? EventCallback.Factory.Create(this, () => CreateInstance(context.Module)) : default)"
                              RunCommand="@(() => Modules.RunCommand(context.Module, context.Instance))" />
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (ShowConfig && context.Module.HasConfig && _expanded.Contains(context.Key))
        {
            <MudTr Class="dwis-child-row">
                <td colspan="7">
                    <ConfigEditor Module="context.Module" Container="context.Container" />
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-4">No modules in this view.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter] public IReadOnlyList<ModuleCategory>? Categories { get; set; }
    [Parameter] public bool GroupByCategory { get; set; }
    [Parameter] public bool MultiSelection { get; set; } = true;
    [Parameter] public bool ShowConfig { get; set; }
    [Parameter] public string? Title { get; set; }

    private readonly HashSet<string> _selectedKeys = new();
    private readonly HashSet<string> _expanded = new();
    // One instance for the whole life of the component: MudTable fires SelectedItemsChanged
    // whenever it sees a new reference, so replacing the set would loop forever.
    private readonly HashSet<ModuleRow> _selected = new();

    private readonly TableGroupDefinition<ModuleRow> _groupDefinition = new()
    {
        GroupName = "Category",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = true,
        Selector = r => r.Module.Category
    };

    private IEnumerable<ModuleRow> Items =>
        Snapshot.Modules
            .Where(m => Categories is null || Categories.Contains(m.Module.Category))
            .SelectMany(ModuleRow.Expand);

    protected override void OnParametersSet() => Reproject();

    private void Reproject()
    {
        // Snapshots are new objects every poll, so the selection is kept by row key
        // and re-projected onto the current snapshot, mutating the set in place.
        var fresh = Items.Where(r => _selectedKeys.Contains(r.Key)).ToList();
        if (fresh.Count == _selected.Count && fresh.All(_selected.Contains)) return;
        _selected.Clear();
        foreach (var r in fresh) _selected.Add(r);
    }

    private void OnSelectionChanged(HashSet<ModuleRow> selected)
    {
        var keys = selected.Select(r => r.Key).ToHashSet();
        if (keys.SetEquals(_selectedKeys)) return;
        _selectedKeys.Clear();
        _selectedKeys.UnionWith(keys);
        Reproject();
    }

    private void ClearSelection()
    {
        _selectedKeys.Clear();
        Reproject();
    }

    private void ToggleConfig(string key)
    {
        if (!ShowConfig) return;
        if (!_expanded.Remove(key)) _expanded.Add(key);
    }

    private string RowClass(ModuleRow r, int index) =>
        Actions.IsBusyWith(r.BusyKey) ? "dwis-row-busy" : "";

    /// <summary>The blackboard details of a blackboard row: the primary one from the status, others from the snapshot.</summary>
    private BlackboardInfo? BlackboardOf(ModuleRow row) =>
        row.Container is null ? null
        : row.Status.Blackboard?.Container.Id == row.Container.Id ? row.Status.Blackboard
        : Snapshot.Blackboards.FirstOrDefault(b => b.Container.Id == row.Container.Id);

    private static int? HostPortOf(ModuleRow row) => row.Instance?.HostPort ?? (row.Exists ? null : row.Module.HostPort);

    private bool BlackboardExists(BlackboardTarget target) =>
        Snapshot.Blackboards.Any(b => b.Container.Name.Equals(target.ContainerName, StringComparison.OrdinalIgnoreCase));

    private string PlaceholderName(ModuleDefinition module) =>
        module.IsWebApp ? Modules.SuggestInstance(module, Modules.DefaultBlackboardTarget()).ContainerName : module.ContainerName;

    private Task Create(ModuleRow row) =>
        row.Module.IsWebApp
            ? CreateInstance(row.Module)
            : RunAsync(ct => Modules.CreateAndStartAsync(row.Module, Actions.Progress, ct), $"{row.Module.DisplayName} created and started.", $"Creating {row.Module.DisplayName}", row.Module.Id);

    private async Task CreateInstance(ModuleDefinition module)
    {
        var spec = await CreateInstanceDialog.ShowAsync(Dialogs, module);
        if (spec is null) return;
        await RunAsync(ct => Modules.CreateInstanceAsync(spec, Actions.Progress, ct),
            $"{module.DisplayName} created for {spec.Blackboard.ContainerName}.", $"Creating {module.DisplayName}", module.Id);
    }

    private async Task UpdateImage(ModuleRow row)
    {
        var module = row.Module;
        if (row.Container is { } c)
        {
            var ok = await ConfirmAsync("Update image",
                $"Pull the latest {module.ImageRef} and recreate the container '{c.Name}'?\nIt will be started again if it is running now.",
                "Update", Color.Info);
            if (!ok) return;
            if (row.Instance is { } instance && c.Id != row.Status.Container?.Id)
            {
                await RunAsync(ct => Modules.UpdateInstanceImageAsync(instance, Actions.Progress, ct), $"{c.Name} updated.", $"Updating {c.Name}", row.BusyKey);
                return;
            }
        }
        await RunAsync(ct => Modules.UpdateImageAsync(module, Actions.Progress, ct), $"{module.DisplayName} updated.", $"Updating {module.DisplayName}", module.Id);
    }

    protected override bool ShouldRender()
    {
        // A new snapshot arrives every poll; keep the selection pointing at the current objects.
        Reproject();
        return true;
    }
}
